# Copy to backend/.env and fill in values.
# NEVER commit backend/.env — it holds secrets and is gitignored.
# Keep the app bound to 127.0.0.1 only (see SECURITY.md). This API has no auth.

# How often inventory should be refreshed (hours)
SCRAPE_INTERVAL_HOURS=6

# How often to check whether a scrape is due (minutes). Handles Mac sleep/wake.
SCRAPE_CHECK_INTERVAL_MINUTES=30

# Handled matches are deleted after this many days
HANDLED_MATCH_RETENTION_DAYS=7

# How often to run handled-match cleanup (hours)
HANDLED_MATCH_CLEANUP_HOURS=24

# Enable Swagger UI at /docs (local debugging only)
ENABLE_API_DOCS=true

# --- Email alerts on new matches (recommended) ---
#
# Google / Google Workspace example:
#   1. Enable 2FA on your Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste below in quotes if it contains spaces
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@yourdomain.com
SMTP_PASSWORD="your-app-password-here"
SMTP_FROM=your.email@yourdomain.com
SMTP_USE_TLS=true
ALERT_EMAIL_TO=your.email@yourdomain.com

# --- SMS alerts via Twilio (optional) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# ALERT_SMS_TO=+15559876543
